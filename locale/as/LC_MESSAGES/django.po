msgstr "✓ লক্ষ্য পোৱা গ’ল"

msgid "Good effort! You remembered %(score)s out of %(total)s items."
msgstr "ভাল প্ৰচেষ্টা! আপুনি %(total)s টাৰ ভিতৰত %(score)s টা সামগ্ৰী মনত ৰাখিলে।"

msgid "Good effort! You placed %(score)s out of %(total)s steps in order."
msgstr "ভাল প্ৰচেষ্টা! আপুনি %(total)s টাৰ ভিতৰত %(score)s টা পদক্ষেপ ক্ৰম অনুসাৰে সজালে।"

msgid "Wonderful! That is your %(relationship)s, %(name)s."
msgstr "চমৎকার! তেওঁ আপোনাৰ %(relationship)s, %(name)s।"

msgid "That is your %(relationship)s, %(name)s. Thank you for looking at this memory together."
msgstr "তেওঁ আপোনাৰ %(relationship)s, %(name)s। একেলগে এই স্মৃতিটো চোৱাৰ বাবে ধন্যবাদ।"

msgid "Good effort! The closest connection is %(target_word)s. %(explanation)s"
msgstr "ভাল প্ৰচেষ্টা! আটাইতকৈ ওচৰৰ সম্পৰ্কটো হ'ল %(target_word)s। %(explanation)s"

msgid "Good effort! The harmonious choice is %(target_name)s. %(explanation)s"
msgstr "ভাল প্ৰচেষ্টা! সুসমন্বিত পছন্দটো হ'ল %(target_name)s। %(explanation)s"

msgid "Back to Familiar People"
msgstr "চিনাকি ব্যক্তিসকললৈ উভতি যাওক"

msgid "Person Name"
msgstr "ব্যক্তিৰ নাম"

msgid "Speak person name"
msgstr "ব্যক্তিৰ নাম কওক"

msgid "Enter how the patient knows this person (e.g. Priya, Aunt Meera, Rajesh)."
msgstr "ৰোগীয়ে এই ব্যক্তিজনক কেনেকৈ চিনি পায় সেয়া দিয়ক (উদাহৰণস্বৰূপে প্ৰিয়া, খুড়ী মীৰা, ৰাজেশ)।"

msgid "Speak relationship"
msgstr "সম্পৰ্ক কওক"

msgid "Active in Familiar Faces gameplay"
msgstr "চিনাকি মুখ খেলত সক্ৰিয়"

msgid "Unchecking pauses this person from appearing in the patient's recognition activity."
msgstr "টিক চিন উঠাই দিলে এই ব্যক্তিজন ৰোগীৰ চিনাক্তকৰণ কাৰ্যসূচীত দেখা পোৱাৰ পৰা বিৰত থাকিব।"

msgid "Close Voice Assistant"
msgstr "ভইচ সহায়ক বন্ধ কৰক"

msgid "Tap the microphone below and speak clearly, or use the direct touch shortcuts below."
msgstr "তলৰ মাইক্ৰ’ফোনত স্পৰ্শ কৰক আৰু স্পষ্টকৈ কওক, বা তলৰ প্ৰত্যক্ষ চৰ্টকাটসমূহ ব্যৱহাৰ কৰক।"

msgid "Try saying:"
msgstr "এইদৰে কৈ চাওক:"

msgid "to play cognitive exercises"
msgstr "জ্ঞানমূলক খেল খেলিবলৈ"

msgid "to check today's activities"
msgstr "আজিৰ কাৰ্যসূচী চাবলৈ"

msgid "to view family photographs"
msgstr "পৰিয়ালৰ ছবি চাবলৈ"

msgid "Tap to Speak"
msgstr "কবলৈ স্পৰ্শ কৰক"

msgid "Listening... Speak now"
msgstr "শুনি থকা হৈছে... এতিয়া কওক"

msgid "Microphone is ready. Tap the button above to begin."
msgstr "মাইক্ৰ’ফোন সাজু। আৰম্ভ কৰিবলৈ ওপৰৰ বুটামত টিপক।"

msgid "Direct Touch Shortcuts:"
msgstr "পোনপটীয়া স্পৰ্শৰ চৰ্টকাটসমূহ:"

msgid "Listening... Please speak now."
msgstr "শুনি থকা হৈছে... অনুগ্ৰহ কৰি এতিয়া কওক।"

msgid "Speech recognition is not supported in this browser. Please use the touch shortcuts below."
msgstr "এই ব্ৰাউজাৰত কণ্ঠ চিনাক্তকৰণ সমৰ্থিত নহয়। অনুগ্ৰহ কৰি তলৰ চৰ্টকাটসমূহ ব্যৱহাৰ কৰক।"

msgid "Microphone access was denied. You can still use the touch shortcuts below."
msgstr "মাইক্ৰ’ফোনৰ অনুমতি প্ৰত্যাখ্যান কৰা হৈছে। আপুনি তথাপিও তলৰ চৰ্টকাটসমূহ ব্যৱহাৰ কৰিব পাৰে।"

msgid "Opening Cognitive Games..."
msgstr "জ্ঞানমূলক খেল খোলা হৈছে..."

msgid "Opening Today's Routine..."
msgstr "আজিৰ দিনলিপি খোলা হৈছে..."

msgid "Opening My Memories..."
msgstr "মোৰ স্মৃতিসমূহ খোলা হৈছে..."

msgid "You said:"
msgstr "আপুনি কৈছিল:"

msgid "Try saying Games, Routine, or Memories, or tap a shortcut below."
msgstr "'খেল', 'ৰুটিন', বা 'স্মৃতি' কৈ চাওক, অথবা তলৰ এটা চৰ্টকাটত টিপক।"

msgid "Start Voice Assistant microphone"
msgstr "ভইচ সহায়ক মাইক্ৰ’ফোন আৰম্ভ কৰক"



msgid "Processing speech..."
msgstr "কণ্ঠ প্ৰক্ৰিয়া কৰা হৈছে..."

msgid "No speech was detected. Please tap the button to try again, or use the touch shortcuts below."
msgstr "কোনো কণ্ঠ চিনাক্ত হোৱা নাই। অনুগ্ৰহ কৰি পুনৰ চেষ্টা কৰিবলৈ বুটামটো টিপক, বা তলৰ চৰ্টকাটসমূহ ব্যৱহাৰ কৰক।"

msgid "Tap the microphone below and speak naturally, or use the direct touch shortcuts below."
msgstr "তলৰ মাইক্ৰ’ফোনত স্পৰ্শ কৰক আৰু স্বাভাৱিকভাৱে কওক, অথবা তলৰ পোনপটীয়া স্পৰ্শৰ চৰ্টকাটসমূহ ব্যৱহাৰ কৰক।"

