# Cognicare Environment Variables Example
# Duplicate this file to .env for local development

# Django Secret Key (generate a secure random secret for production)
DJANGO_SECRET_KEY=django-insecure-cognicare-dev-key-change-in-production

# Debug Mode (True for development, False for production)
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list of domains/IPs)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins (comma-separated list of complete URLs including scheme, e.g. https://yourdomain.com)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database URL (leave empty for local SQLite; provide PostgreSQL URL for production)
DATABASE_URL=

# Time Zone
TIME_ZONE=Asia/Kolkata

# Media Storage Configuration (leave blank for local FileSystemStorage; configure for production object storage)
# Supports AWS S3, Cloudflare R2, Backblaze B2, or any S3-compatible provider
MEDIA_STORAGE=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=



